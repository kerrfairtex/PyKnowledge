# Database
# DATABASE_URL="postgresql://pyknowledge:***@localhost:5432/pyknowledge?schema=public"
# Supabase (recommended for production)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# API Server
PORT=3000
NODE_ENV=development
JWT_SECRET="change-this-in-production-use-long-random-string"
JWT_EXPIRES_IN="7d"

# CORS (client origin)
CORS_ORIGIN="http://localhost:8080"

# Default institution for new registrations
DEFAULT_INSTITUTION_NAME="TRAC"
