{
  "name": "pyknowledge",
  "version": "0.2.0",
  "description": "Offline Python Learning Platform for TRAC/BARMM/CHED curriculum",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npx --yes serve -l 8080",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "npm test -- --watch",
    "test:perf": "node scripts/perf-smoke.js",
    "lint": "eslint .",
    "validate:content": "node scripts/validate-content.js",
    "check:version": "node scripts/check-version.js",
    "package": "node scripts/package.js"
  },
  "keywords": ["offline", "pwa", "python", "education", "ched"],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  },
  "engines": {
    "node": ">=18"
  }
}
