{
  "name": "pyknowledge-server",
  "version": "0.4.0",
  "description": "PyKnowledge API server — content, auth, and progress",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "test": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js --config jest.config.js",
    "test:integration": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js --config jest.config.js --testPathPattern=integration"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.26.0",
    "babel-jest": "^29.7.0",
    "prisma": "^6.2.1",
    "supertest": "^7.0.0"
  }
}
