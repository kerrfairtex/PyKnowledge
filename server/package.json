{
  "name": "pyknowledge-server",
  "version": "0.4.0",
  "description": "PyKnowledge API server — content, auth, and progress",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "test": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js --config jest.config.js",
    "test:integration": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js --config jest.config.js --testPathPattern=integration"
  },
  "dependencies": {
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/preset-env": "^8.0.2",
    "babel-jest": "^30.4.1",
    "prisma": "^7.9.1",
    "supertest": "^7.0.0"
  }
}
