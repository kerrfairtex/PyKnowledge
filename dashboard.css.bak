/* ==========================================================================
   PyKnowledge — Dashboard styles (route: /dashboard)
   Same tokens as index.css so the app shell and marketing page feel like
   one product. fCC-style bordered list cards — no shadows, no photos,
   icon + text only, per your note to keep this page clean/organized.
   ========================================================================== */

:root {
  --bg: #0a0a23;
  --panel: #1b1d3d;
  --panel-border: #2c2f57;
  --panel-border-hover: #3d4174;
  --text: #f5f6fa;
  --text-dim: #a9adc9;
  --yellow: #ffc900;
  --yellow-ink: #1a1300;
  --green: #2fbd60;
  --blue: #5b9dff;
  --lock: #565a7e;
  --font-display: 'Segoe UI', -apple-system, BlinkMacSystemFont, 'Liberation Sans', sans-serif;
  --font-body: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Liberation Sans', sans-serif;
  --font-mono: ui-monospace, 'Cascadia Code', 'Consolas', 'Liberation Mono', monospace;
  --radius: 10px;
}

.dash {
  max-width: 760px;
  margin: 0 auto;
  padding: 32px 20px 64px;
  font-family: var(--font-body);
  color: var(--text);
}

.dash-loading,
.dash-error {
  color: var(--text-dim);
  padding: 40px 0;
  text-align: center;
}
.dash-error { color: var(--yellow); }

/* ---------- Flash toast (fCC sign-in-success pattern) ---------- */
.dash-toast {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  background: rgba(47, 189, 96, 0.12);
  border: 1px solid rgba(47, 189, 96, 0.4);
  color: var(--green);
  padding: 12px 16px;
  border-radius: var(--radius);
  font-size: 0.92rem;
  margin-bottom: 24px;
  animation: dash-toast-in 180ms ease-out;
}
@keyframes dash-toast-in {
  from { opacity: 0; transform: translateY(-6px); }
  to { opacity: 1; transform: translateY(0); }
}
.dash-toast-dismiss {
  background: none;
  border: none;
  color: var(--green);
  width: 22px;
  height: 22px;
  padding: 0;
  cursor: pointer;
  opacity: 0.75;
}
.dash-toast-dismiss:hover { opacity: 1; }
.dash-toast-dismiss svg { width: 100%; height: 100%; }

/* ---------- Header ---------- */
.dash-head { margin-bottom: 24px; }
.dash-head h1 {
  font-family: var(--font-display);
  font-size: 1.7rem;
  margin: 0 0 4px;
}
.dash-head p {
  color: var(--text-dim);
  margin: 0;
}

/* ---------- Overall progress ---------- */
.dash-overall {
  background: var(--panel);
  border: 1px solid var(--panel-border);
  border-radius: var(--radius);
  padding: 18px 20px;
  margin-bottom: 28px;
}
.dash-overall-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 10px;
  font-size: 0.92rem;
}
.dash-overall-count {
  font-family: var(--font-mono);
  color: var(--text-dim);
}

.dash-bar {
  height: 8px;
  background: var(--bg);
  border: 1px solid var(--panel-border);
  border-radius: 999px;
  overflow: hidden;
}
.dash-bar--small { height: 6px; margin: 10px 0 6px; }
.dash-bar-fill {
  height: 100%;
  background: var(--green);
  border-radius: 999px;
  transition: width 220ms ease-out;
}

/* ---------- Module list (fCC bordered-list reference) ---------- */
.dash-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.dash-card {
  display: flex;
  gap: 16px;
  background: var(--panel);
  border: 1px solid var(--panel-border);
  border-radius: var(--radius);
  padding: 20px;
  transition: border-color 150ms ease-out, transform 150ms ease-out;
}
.dash-card:hover { border-color: var(--panel-border-hover); }

.dash-card-icon {
  flex: none;
  width: 40px;
  height: 40px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg);
  border: 1px solid var(--panel-border);
  color: var(--yellow);
}
.dash-card-icon svg { width: 22px; height: 22px; }

.dash-card-body { flex: 1; min-width: 0; }

.dash-card-title-row {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 4px;
}
.dash-card-title-row h3 {
  font-family: var(--font-display);
  font-size: 1.05rem;
  margin: 0;
}
.dash-card-badge {
  width: 18px;
  height: 18px;
  color: var(--lock);
  flex: none;
}
.dash-card-badge svg { width: 100%; height: 100%; }
.dash-card-badge--done { color: var(--green); }

.dash-card-desc {
  color: var(--text-dim);
  font-size: 0.88rem;
  margin: 0 0 12px;
  line-height: 1.45;
}

.dash-card-count {
  font-family: var(--font-mono);
  font-size: 0.74rem;
  color: var(--text-dim);
  margin-bottom: 14px;
}

.dash-card-btn {
  display: inline-block;
  background: var(--yellow);
  color: var(--yellow-ink);
  font-family: var(--font-display);
  font-weight: 700;
  font-size: 0.88rem;
  padding: 9px 18px;
  border-radius: 6px;
  text-decoration: none;
  transition: background 150ms ease-out;
}
.dash-card-btn:hover { background: #ffd93d; }

.dash-card-locked-note {
  font-family: var(--font-mono);
  font-size: 0.76rem;
  color: var(--yellow);
  margin: 0;
}

/* Locked cards read as inactive — no icon color, no button */
.dash-card--locked {
  opacity: 0.7;
}
.dash-card--locked .dash-card-icon {
  color: var(--lock);
}

.dash-card--done .dash-card-icon {
  color: var(--green);
  border-color: var(--green);
}

/* ---------- Responsive ---------- */
@media (max-width: 480px) {
  .dash-card { padding: 16px; gap: 12px; }
  .dash-card-icon { width: 34px; height: 34px; }
  .dash-card-icon svg { width: 18px; height: 18px; }
}
